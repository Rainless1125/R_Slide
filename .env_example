GEMINI_API_KEY=
OPENAI_API_KEY=
# 選填：OpenAI 相容端點（公司內部 AI 閘道、Azure OpenAI、vLLM、Ollama 等），通常以 /v1 結尾
OPENAI_BASE_URL=
# 選填：可用的模型（以逗號分隔，第一個為預設）；不填時為 gpt-6-luna
OPENAI_MODELS=
# 選填：模型選單上顯示的平台名稱，例如「公司 AI 閘道」
OPENAI_DISPLAY_NAME=
# Databricks 也是 OpenAI 相容端點：OPENAI_API_KEY 填權杖，OPENAI_BASE_URL 填 https://<workspace>/serving-endpoints

# 選填：呼叫 AI 時附加的 HTTP 標頭（JSON 物件，值只能用英數字與符號），例如公司 AI 閘道要求的系統名稱與使用區域
# LLM_EXTRA_HEADERS={"system_name": "R_Slide", "use_area": "部門或廠域代號"}

# 登入方式：system（內建的註冊與帳號，預設）或 ldap（公司 LDAP / Active Directory 帳號，不開放註冊）
# AUTH_MODE=system
# AUTH_MODE=ldap 時必填 LDAP_SERVER，並在 LDAP_USER_DN_TEMPLATE（直接綁定）與 LDAP_SEARCH_BASE（先搜尋再綁定）中擇一
# LDAP_SERVER=ldaps://ad.corp.example.com
# LDAP_USER_DN_TEMPLATE={username}@corp.example.com
# LDAP_SEARCH_BASE=dc=corp,dc=example,dc=com
# LDAP_USER_FILTER=(sAMAccountName={username})
# LDAP_BIND_DN=
# LDAP_BIND_PASSWORD=
# LDAP_START_TLS=false
# LDAP_CA_CERT_FILE=
# LDAP_TIMEOUT=5

# 企業 / 品牌識別圖示的資料夾（選填，預設為專案目錄下的 brand_icon）
# BRAND_ICON_DIR=brand_icon

# 帳號與歷史記錄（SQLite）：皆為選填
# RSLIDE_DB_PATH=data/rslide.db
# ALLOW_REGISTRATION=true
# 同一 IP 在 24 小時內最多可自行註冊幾個帳號，0 為不限制
# REGISTER_LIMIT_PER_IP_PER_DAY=1
# COOKIE_SECURE=false
# LLM 使用紀錄保留天數，0 為永久保留
# LLM_USAGE_RETENTION_DAYS=365
# 每個帳號的生成 / 大綱 / 重產次數上限，0 為不限制
# LLM_RATE_LIMIT_PER_HOUR=20
# LLM_RATE_LIMIT_PER_DAY=100
# LLM_MAX_CONCURRENT=2

# 匯入 PowerPoint 或掃描的 PDF 時用 AI 辨識圖片與掃描頁（使用者選擇的模型）：皆為選填
# EXTRACT_IMAGES=true
# 一個檔案最多辨識幾張圖片（PDF 的一個掃描頁算一張），0 為不限制（預設 50）
# EXTRACT_IMAGE_MAX=50
# 同時辨識幾頁
# EXTRACT_IMAGE_CONCURRENCY=4

# 後台管理頁面（/admin）的管理者帳號密碼：兩項都填才會啟用後台
# 密碼需 8~128 個字元，且至少包含一個英文字母與一個數字；修改後重新啟動服務，已登入的後台 session 會失效
ADMIN_USERNAME=
ADMIN_PASSWORD=
