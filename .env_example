GEMINI_API_KEY=
OPENAI_API_KEY=

# Databricks AI Gateway（三項都填才會啟用；DATABRICKS_MODELS 以逗號分隔，第一個為預設）
DATABRICKS_HOST=
DATABRICKS_TOKEN=
DATABRICKS_MODELS=
# 選填：預設為 <DATABRICKS_HOST>/serving-endpoints
DATABRICKS_BASE_URL=

# 帳號與歷史記錄（SQLite）：皆為選填
# RSLIDE_DB_PATH=data/rslide.db
# ALLOW_REGISTRATION=true
# 同一 IP 在 24 小時內最多可自行註冊幾個帳號，0 為不限制
# REGISTER_LIMIT_PER_IP_PER_DAY=1
# COOKIE_SECURE=false
# LLM 使用紀錄保留天數，0 為永久保留
# LLM_USAGE_RETENTION_DAYS=365
# 每個帳號的生成 / 大綱 / 重產次數上限，0 為不限制
# LLM_RATE_LIMIT_PER_HOUR=20
# LLM_RATE_LIMIT_PER_DAY=100
# LLM_MAX_CONCURRENT=2

# 匯入 PowerPoint 時用 AI 辨識投影片中的圖片（使用者選擇的模型）：皆為選填
# EXTRACT_IMAGES=true
# 一個檔案最多辨識幾張圖片，0 為不限制
# EXTRACT_IMAGE_MAX=0
# 同時辨識幾頁
# EXTRACT_IMAGE_CONCURRENCY=4

# 後台管理頁面（/admin）的管理者帳號密碼：兩項都填才會啟用後台
# 密碼需 8~128 個字元，且至少包含一個英文字母與一個數字；修改後重新啟動服務，已登入的後台 session 會失效
ADMIN_USERNAME=
ADMIN_PASSWORD=
